{
 "_doc": "Tiers for the AI per-game settings. allow = the AI may change it; risky = only with a curated precedent on the server, shown as experimental; preference = the player's taste, never changed; never = the AI never changes it. Cvars missing here are never. See README.md.",
 "schema_version": 1,
 "app": [
  {
   "key": "draw_resolution_scale",
   "type": "int",
   "default": "1",
   "ui_title": "Internal resolution",
   "enum": [
    {
     "name": "1x (native)",
     "value": 1
    },
    {
     "name": "2x",
     "value": 2
    },
    {
     "name": "3x",
     "value": 3
    }
   ],
   "description": "Internal rendering resolution as a multiple of the game's own (draw_resolution_scale_x and _y). Higher is sharper and costs GPU time roughly with the pixel count; a few games show seams or broken post-processing above 1x."
  },
  {
   "key": "kiwi_rtz_software_emulation",
   "type": "bool",
   "default": "false",
   "ui_title": "Exact vertex rounding",
   "description": "Emulates the Xenos round-toward-zero vertex shader arithmetic in software where results become indices, addresses or exports, on GPUs without it in hardware (Adreno, Mali). Fixes rare geometry spikes or missing objects at a GPU cost; most games look the same without it."
  }
 ],
